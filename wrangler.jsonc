/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stonebridge-promo",
	"compatibility_date": "2026-10-30",
	// nodejs_compat includes nodejs_als: AsyncLocalStorage carries the per-request D1 session (app/server/db.ts);
	// exceljs (quote .xlsx) needs the rest of nodejs_compat
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Both can be overridden in .dev.vars for local dev. Declared here because with `secrets`
	// set, .dev.vars keys that are neither secrets nor vars are not loaded.
	"vars": {
		// Origin Claude fetches signed photo URLs from. Placeholder until the first deploy (Task 9);
		// while it is an `example` host, generation fails at once with an admin message
		// (docs/deploy-checklist.md).
		// Local dev: http://localhost:5173 (not https, so photos go to Claude as base64).
		// The pages.dev front (edge/), reached from Korea via Seoul. Requests on the workers.dev host
		// are 308-redirected here (app/server/canonical-host.ts).
		"PUBLIC_ORIGIN": "https://stonebridge-promo.pages.dev",
		// "1" = canned drafts instead of calling Claude. Local dev only.
		"FAKE_CLAUDE": "0",
		// "1" = the public demo (env.demo below): no login, AI call cap, daily reset. Off here.
		"DEMO": "0"
	},
	// set via `wrangler secret put` (prod) / .dev.vars (local)
	"secrets": {
		"required": ["ANTHROPIC_API_KEY", "SESSION_SECRET", "OWNER_INITIAL_PASSWORD", "IMAGE_URL_SECRET"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "promo-agent",
			// placeholder until `wrangler d1 create promo-agent` (Task 9)
			"database_id": "1c172fe9-6cbb-4f6b-b3ca-16fe498076dc",
			"migrations_dir": "drizzle"
		}
	],
	// 사진 (private: r2.dev / custom domain 공개 접근 켜지 않음)
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "promo-photos"
		}
	],
	// UTC; KST = UTC+9. Keep in sync with CRONS in app/kakao/alerts.server.ts (Kakao alerts) and
	// WATCH_CRON in app/watch/run.server.ts.
	// 14:20 UTC = 23:20 KST 발주 알림; 01:00 UTC = 10:00 KST 홍보글 알림 (sends on her chosen day(s) only);
	// 18:00 UTC = 03:00 KST 경쟁 업체 감시 (starts the `watch` Workflow).
	"triggers": {
		"crons": ["20 14 * * *", "0 1 * * *", "0 18 * * *"]
	},
	"workflows": [
		{
			"name": "generate-post",
			"binding": "GENERATE",
			"class_name": "GeneratePostWorkflow"
		},
		{
			"name": "quote-generate",
			"binding": "QUOTE_GENERATE",
			"class_name": "QuoteGenerateWorkflow"
		},
		{
			"name": "watch",
			"binding": "WATCH",
			"class_name": "WatchWorkflow"
		}
	],
	// Public demo for the AX challenge review: a separate Worker (stonebridge-promo-demo) with its
	// own D1, R2 and Workflows, fictional data only, no Kakao secrets. Build with
	// `CLOUDFLARE_ENV=demo` (the Vite plugin picks the env at build time): `npm run deploy:demo`.
	// Bindings and vars are not inherited, so every one is restated here and must never point at
	// the owner's resources. Workflow names are unique per account, hence the -demo suffix.
	"env": {
		"demo": {
			"name": "stonebridge-promo-demo",
			"vars": {
				// The demo's own pages.dev front (edge-demo/), Seoul edge like the owner's app.
				"PUBLIC_ORIGIN": "https://stonebridge-promo-demo.pages.dev",
				"FAKE_CLAUDE": "0",
				"DEMO": "1"
			},
			"secrets": {
				"required": ["ANTHROPIC_API_KEY", "SESSION_SECRET", "OWNER_INITIAL_PASSWORD", "IMAGE_URL_SECRET"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "promo-demo",
					"database_id": "a524742f-7300-45a1-be13-68d8d9f643c6",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "PHOTOS",
					"bucket_name": "promo-demo-photos"
				}
			],
			// 19:00 UTC = 04:00 KST: put the demo back to its sample data (app/demo/reset.server.ts).
			// No Kakao alerts, no competitor watch.
			"triggers": {
				"crons": ["0 19 * * *"]
			},
			"workflows": [
				{
					"name": "generate-post-demo",
					"binding": "GENERATE",
					"class_name": "GeneratePostWorkflow"
				},
				{
					"name": "quote-generate-demo",
					"binding": "QUOTE_GENERATE",
					"class_name": "QuoteGenerateWorkflow"
				},
				{
					"name": "watch-demo",
					"binding": "WATCH",
					"class_name": "WatchWorkflow"
				}
			]
		}
	}
}
